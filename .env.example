# ============================================================================
#  Algorithm CRM — Environment Variables
#  Copy this file to .env.local and fill in the values
# ============================================================================

# Supabase — from your project dashboard at https://supabase.com/dashboard
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Service role key (KEEP SECRET — never expose to browser)
# Used by the cron job to process alerts for all users
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Cron secret — generate any random string. Used to authenticate Vercel Cron calls.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# Finance export API key (optional) — lets the finance tracker pull
# /api/export/deals without a CRM login. Generate with: openssl rand -base64 32
EXPORT_API_KEY=

# Email alert digests (optional) — via https://resend.com. Leave blank for in-app only.
RESEND_API_KEY=
ALERT_EMAIL_FROM=CRM Alerts <crm@algorithm.agency>
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
